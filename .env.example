# Copy to .env.local (git-ignored) and paste your key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Personal assistant: Auto tries Claude, then ChatGPT on connection/auth/usage failures.
# ChatGPT uses your existing Codex ChatGPT sign-in. Run `codex login` once; no OpenAI API key.
THK_PROVIDER=auto
# Optional: use a specific model returned by your account's model catalog.
# THK_CHATGPT_MODEL=
# Optional: absolute path if the Codex CLI isn't on the server's PATH.
# THK_CODEX_BIN=
