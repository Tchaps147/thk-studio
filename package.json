{
  "name": "thk-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "node tools/kit-web.mjs && node apps/web/node_modules/vite/bin/vite.js build apps/web",
    "kit:web": "node tools/kit-web.mjs",
    "typecheck": "tsc -p packages/song && tsc -p packages/audio && tsc -p apps/api && tsc -p apps/web && tsc -p e2e",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures:prototype": "node tools/prototype-events.mjs",
    "preview": "node tools/dev.mjs preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "node-web-audio-api": "^1.0.9",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.7"
  }
}
